GOATCOUNTER_TOKEN=your-api-token-here

# Parent account site code (recommended). GET /api/v0/sites on this host
# returns every child site. For this board the parent is typically "iwp".
GOATCOUNTER_ACCOUNT=iwp

# Fallback list if GOATCOUNTER_ACCOUNT is unset. Comma-separated
# GoatCounter site codes (subdomain before .goatcounter.com).
GOATCOUNTER_SITES=venabustallenno,kryptobotno,orlandlufthavnno,smartpageno

# Maps a GoatCounter site code to its real domain, for Ahrefs Domain Rating
# and matching sheet domains (!no goat). Sites left out show as "Offline".
GOATCOUNTER_SITE_DOMAINS=venabustallenno:venabustallen.no,kryptobotno:kryptobot.no,orlandlufthavnno:orlandlufthavn.no,smartpageno:smartpage.no
AHREFS_API_KEY=your-ahrefs-api-key-here

# Public Google Sheet (Anyone with the link) used for the Link web.
GOOGLE_SHEET_ID=1Yu96Qh6YclSEP3tKI_V7Ij-KjcZW3RYUXCMeqBmQG-g
GOOGLE_SHEET_LINKS_GID=433713429

# Optional in-memory cache TTLs (milliseconds). Board Refresh always bypasses.
# CACHE_TTL_SITES_MS=600000
# CACHE_TTL_OVERVIEW_MS=180000
# CACHE_TTL_STATS_ALL_MS=180000
# CACHE_TTL_STATS_SITE_MS=90000
# CACHE_TTL_LINKS_MS=120000
