GOATCOUNTER_SITES=venabustallenno,iwp
GOATCOUNTER_TOKEN=your-api-token-here

# Maps a GoatCounter site code to its real domain, for Ahrefs Domain Rating
# lookups. Sites left out (no live domain yet) show as "Offline" instead.
GOATCOUNTER_SITE_DOMAINS=venabustallenno:venabustallen.no
AHREFS_API_KEY=your-ahrefs-api-key-here
